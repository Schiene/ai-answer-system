# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# サーバー設定
# 配信サブディレクトリ。本番(rurucoa.com)は /aas。未設定ならルート直下で動く。
# nginx の location ^~ /aas/ と必ず揃えること。
BASE_PATH=

PORT=3001

# ルーム設定
ROOM_ID_LENGTH=10
ROOM_EXPIRY_MINUTES=60
RATE_LIMIT_SECONDS=10
STABLE_FRAME_COUNT=4

# HTTPS設定（mkcert等で生成した証明書パスを指定。省略時はHTTP）
SSL_CERT_PATH=
SSL_KEY_PATH=
