# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# サーバー設定
# 配信サブディレクトリ。本番(rurucoa.com)は /aas。未設定ならルート直下で動く。
# nginx の location ^~ /aas/ と必ず揃えること。
BASE_PATH=

PORT=3001

# ルーム設定
ROOM_ID_LENGTH=10
# ルームの有効期限（分）。0 = 無期限。
# 「自分で画面やカメラを閉じるまでは動き続ける」ことを優先して 0 を既定にしている。
ROOM_EXPIRY_MINUTES=0
RATE_LIMIT_SECONDS=10

# 閲覧側が切断してからルームを片付けるまでの猶予（秒）。
# 電波の一瞬の途切れや画面スリープで部屋が消えないようにするため。
DISPLAY_GRACE_SECONDS=180

# Gemini の応答を待つ上限（秒）。0 にしないこと（応答が返らないときルームが固まる）。
AI_TIMEOUT_SECONDS=30

# 一時的な失敗（レート制限・通信断）の再試行回数。
AI_MAX_RETRIES=1

# 変化検知の閾値は環境変数ではない。public/camera.html 先頭の
# CHANGE_THRESHOLD / STILL_THRESHOLD / STILL_FRAMES_REQUIRED を直接編集する。

# HTTPS設定（mkcert等で生成した証明書パスを指定。省略時はHTTP）
SSL_CERT_PATH=
SSL_KEY_PATH=
